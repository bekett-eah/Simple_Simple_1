{
  "name": "simple-sv-app",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicación móvil de Simple.sv (Capacitor): empaqueta el frontend web del repositorio y agrega identidad, sesión con biometría y pagos modulares.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/construir-web.mjs --entorno=desarrollo",
    "build:pruebas": "node scripts/construir-web.mjs --entorno=pruebas",
    "build:produccion": "node scripts/construir-web.mjs --entorno=produccion",
    "sync": "npm run build && cap sync android",
    "sync:pruebas": "npm run build:pruebas && cap sync android",
    "android": "npm run sync && cap open android",
    "servir": "node scripts/servir-www.mjs",
    "iconos": "node scripts/generar-iconos.mjs",
    "test": "node --test tests/*.test.mjs",
    "verificar": "npm test && npm run sync:pruebas && node scripts/verificar-paquete.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/network": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capgo/capacitor-native-biometric": "8.9.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@fontsource/manrope": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@phosphor-icons/web": "2.1.2",
    "esbuild": "0.28.2",
    "sharp": "0.35.5"
  }
}
